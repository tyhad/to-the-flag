# Path to the read-only F1GStats database
F1GSTATS_DB=../F1GStats/f1gstats.sqlite
# Python for `bun run refresh`; it must have FastF1 installed (usually the F1GStats venv).
# F1GSTATS_PY=../F1GStats/venv/Scripts/python.exe
# Where saved scenarios are kept
TTF_DB=./to-the-flag.sqlite
# Server. LiveOverlay Studio uses 3000.
PORT=3100
HOST=127.0.0.1
# Write token for LAN mode (required when HOST is not loopback; min 16 characters)
TTF_WRITE_TOKEN=
# Extra host names that may write, comma-separated, no http://, no port (for example mypc.local).
# localhost and IP addresses always work, so a phone using http://192.168.1.20:3100 needs nothing here.
TTF_ALLOWED_HOSTS=
